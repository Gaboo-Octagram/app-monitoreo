# Archivos sensibles / respaldos
*.json
!package.json
*.bak
*.backup
*.zip
# Los volcados de datos no se suben; el esquema sí es código del proyecto.
*.sql
!docs/schema.sql
!docs/migraciones/*.sql

# Fotos / archivos subidos
*.jpg
*.jpeg
*.png
*.webp
*.heic
*.pdf
*.doc
*.docx
*.xls
*.xlsx

# Logs / temporales
*.log
.DS_Store
Thumbs.db

# Variables / claves
.env
.env.*
service-account*.json
supabase-key*.json

# Supabase config
src/supabaseClient.js

# IDE
.vscode/
.idea/
*.swp
*.swo

# Excepciones (deben ir después de las reglas anteriores)
!package-lock.json
!manifest.json
# Imágenes de referencia en docs/ (solo maquetas, sin datos reales)
!docs/*.png
!docs/*.jpg
!docs/*.jpeg
!docs/*.webp
!docs/*.pdf

# Dependencias
node_modules/
